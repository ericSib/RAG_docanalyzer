{
    "ml": {
        "embedding_model": "paraphrase-multilingual-MiniLM-L12-v2",
        "spacy_model": "fr_core_news_md",
        "chunk_size": 1000,
        "chunk_overlap": 200,
        "models_dir": "resources/ml_models",
        "cache_dir": "data/cache/models"
    },
    "storage": {
        "db_path": "data/rag.db",
        "documents_dir": "data/documents",
        "models_dir": "data/models",
        "max_file_size": 10485760,
        "supported_formats": [
            "txt",
            "pdf",
            "doc",
            "docx"
        ]
    },
    "logging": {
        "level": "INFO",
        "file": "logs/rag.log",
        "format": "%(asctime)s - %(name)s - %(levelname)s - %(message)s",
        "max_size": 10485760,
        "backup_count": 5
    },
    "ai": {
        "temperature": 0.7,
        "max_tokens": 1000,
        "top_p": 0.95,
        "frequency_penalty": 0.0,
        "presence_penalty": 0.0,
        "stop_sequences": ["\n\n", "###"]
    },
    "app": {
        "name": "RAG Analyzer",
        "version": "1.0.0",
        "description": "Application d'analyse de documents avec RAG",
        "author": "Codeium",
        "license": "MIT"
    },
    "debug": false,
    "env": "production"
}
